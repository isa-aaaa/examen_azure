{
	"name": "df_bronze_facturacion",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "bronze_facturacion_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "bronze_facturacion_csv",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 select(mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     )) ~> sink1"
			]
		}
	}
}