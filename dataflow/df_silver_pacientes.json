{
	"name": "df_silver_pacientes",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "silver_pacientes_sql",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_pacientes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "derivedColumn5"
				},
				{
					"name": "derivedColumn6"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(full_name = trim(regexReplace(regexReplace(full_name, '^(Mr|Mrs|Ms|Miss|Dr)[.]?[ ]+', ''), '[ ]+(Jr|Sr|II|III|IV|MD|DDS|DVM|PhD)[.]?$', ''))) ~> derivedColumn1",
				"derivedColumn3 derive(phone = iif(length(regexReplace(toString(phone), '[^0-9]', '')) == 11 && startsWith(regexReplace(toString(phone), '[^0-9]', ''), '1'),     substring(regexReplace(toString(phone), '[^0-9]', ''), 2, 10),     iif(length(regexReplace(toString(phone), '[^0-9]', '')) == 10,         regexReplace(toString(phone), '[^0-9]', ''),         toString(null())))) ~> derivedColumn2",
				"derivedColumn1 derive(gender = case(lower(substring(trim(gender), 1, 1)) == 'm', 'Male', lower(substring(trim(gender), 1, 1)) == 'f', 'Female', 'Other')) ~> derivedColumn3",
				"derivedColumn5 derive(date_of_birth = toDate(date_of_birth, 'yyyy-MM-dd')) ~> derivedColumn4",
				"derivedColumn6 derive(insurance_provider = lower(regexReplace(toString(insurance_provider), '[^a-zA-Z]', '')),",
				"          insurance_provider = case(:ins_key == 'bluecross', 'BlueCross',      :ins_key == 'unitedhealth', 'UnitedHealth',      :ins_key == 'medicare', 'Medicare',      :ins_key == 'medicaid', 'Medicaid',      :ins_key == 'selfpay', 'Self-Pay',      :ins_key == 'cigna', 'Cigna',      :ins_key == 'aetna', 'Aetna',      'Unknown')) ~> derivedColumn5",
				"derivedColumn2 derive(email = iif(isNull(email) || upper(trim(email)) == 'NULL',     toString(null()),     lower(trim(regexReplace(email, '[.]{2,}', '.'))))) ~> derivedColumn6",
				"derivedColumn4 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}